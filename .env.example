# Local SQLite: npm start. Hosted values below belong in Vercel server variables.
# Never commit your actual .env files or paste credentials into issues.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
FLAG_ADMIN_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
RUNTIME_VAULT_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
CRON_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
QSTASH_CURRENT_SIGNING_KEY=REPLACE_FROM_UPSTASH
QSTASH_NEXT_SIGNING_KEY=REPLACE_FROM_UPSTASH
# PUBLIC_ORIGIN=https://YOUR_PROJECT.vercel.app
# OPENAI_API_KEY=CONFIGURE_IN_SERVER_ENV_OR_WORKSPACE_PROVIDER_CREDENTIALS
